# Copy this file to .env and fill in your values before starting with docker-compose

# JWT signing key — REQUIRED, generate with: openssl rand -hex 32
SECRET_KEY=

# Admin user password — if not set, a random password is generated and printed to server logs
ADMIN_PASSWORD=

# PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=jobdb

# RabbitMQ
RABBITMQ_USER=jobagent
RABBITMQ_PASS=change_me_in_production

# Celery (auto-built from above if not set explicitly)
# DATABASE_URL=postgresql://user:password@ai-job-agent-database:5432/jobdb
# CELERY_BROKER_URL=amqp://user:password@ai-job-agent-rabbitmq:5672//

# Page render service (doublelayer/page-render-service, renders job-board pages for the scraper)
# API key — REQUIRED, at least 32 characters; compose passes it to the service as API_KEYS.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
RENDER_API_KEY=
# Optional: where the server reaches the render service (default http://ai-job-agent-page-render:8000/api/v1/render)
# RENDER_API_URL=http://ai-job-agent-page-render:8000/api/v1/render
# Optional: render adapter the server uses (default page-render-service)
# RENDER_SERVICE=page-render-service
# Optional: parallel browsers in the render service (default 2)
# RENDER_MAX_WORKERS=2

# Notification service (notification-service/, compose service ai-job-agent-notify, no host port)
# API key of this app at the service — REQUIRED, at least 32 characters. The server sends it as
# NOTIFY_API_KEY (the API and the AI worker refuse to start without it); compose passes it to the
# service as NOTIFY_API_KEYS=ai-job-agent:<key>.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NOTIFY_API_KEY=
# Key that encrypts the stored channel settings — REQUIRED, a Fernet key. Losing or changing it makes
# every stored channel unreadable. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NOTIFY_ENCRYPTION_KEY=
# Optional, only during a key rotation: the previous NOTIFY_ENCRYPTION_KEY. To rotate, put the old
# key here and a new one in NOTIFY_ENCRYPTION_KEY, restart the service (it re-encrypts every channel
# with the new key at startup and logs the count), then remove this line and restart again.
# NOTIFY_ENCRYPTION_KEY_OLD=
# Optional: where the server reaches the service (default http://ai-job-agent-notify:8000)
# NOTIFY_API_URL=http://ai-job-agent-notify:8000
# Service-side variable, set by compose from NOTIFY_API_KEY: comma-separated app_id:key pairs, one
# per calling app (app_id: a-z, 0-9, _ or -; every key unique, at least 32 characters). Only needed
# when running the service outside this compose file or for further apps.
# NOTIFY_API_KEYS=ai-job-agent:<key>,other-app:<other key>

# Cookie security — set to true in production (requires HTTPS)
COOKIE_SECURE=false

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Frontend API URL (used by frontend container to reach server)
APP_API_URL=http://localhost:8002
